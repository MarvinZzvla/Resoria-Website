---
import type { SiteContent } from '../types/content';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import { SITE_ORIGIN } from '../../site.config.mjs';
import { absoluteUrl, publicAsset, sitePath } from '../lib/assets';
import { getLegalPaths } from '../lib/legal';
import { whatsappUrl } from '../lib/whatsapp';
import '../styles/global.css';

interface Props {
  content: SiteContent;
  pageSeo?: { title: string; description: string };
  canonicalPath?: string;
  alternatePath?: string;
  hideHeader?: boolean;
}

const { content, pageSeo, canonicalPath, alternatePath, hideHeader = false } = Astro.props;
const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? SITE_ORIGIN;
const legalPaths = getLegalPaths(content.locale);
const whatsappLink = whatsappUrl(content.contactSection.contactInfo.whatsapp);
const whatsappNumber = content.contactSection.contactInfo.whatsapp;
const whatsappAriaLabel =
  content.lang === 'es'
    ? `Escríbenos por WhatsApp al ${whatsappNumber}`
    : `Message us on WhatsApp at ${whatsappNumber}`;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Resoria',
  url: absoluteUrl(sitePath(`${content.locale}/`), siteUrl),
  logo: absoluteUrl('/logos/resoria.png', siteUrl),
  description: content.seo.description,
  email: content.contactSection.contactInfo.email,
  telephone: content.contactSection.contactInfo.whatsapp,
  sameAs: [],
};

const softwareSchemas = content.products.map((product) => ({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: product.name,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web, Windows',
  description: product.description,
  offers: product.plans.map((plan) => ({
    '@type': 'Offer',
    name: plan.name,
    price: plan.price.replace('$', ''),
    priceCurrency: 'USD',
    description: plan.features.join('. '),
    url: absoluteUrl(sitePath(`${content.locale}/#${content.contactSection.id}`), siteUrl),
  })),
  provider: {
    '@type': 'Organization',
    name: 'Resoria',
    url: absoluteUrl(sitePath(`${content.locale}/`), siteUrl),
  },
}));

const jsonLd = [organizationSchema, ...softwareSchemas];
---

<!doctype html>
<html lang={content.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={publicAsset('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Exo+2:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <Seo
      title={pageSeo?.title ?? content.seo.title}
      description={pageSeo?.description ?? content.seo.description}
      locale={content.locale}
      alternateLocale={content.alternateLocale}
      ogImageAlt={content.seo.ogImageAlt}
      canonicalPath={canonicalPath}
      alternatePath={alternatePath}
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    {!hideHeader && <Header content={content} />}
    <main id="main-content">
      <slot />
    </main>
    <footer class="mt-8 border-t border-white/10 py-12">
      <div class="mx-auto flex w-[min(1120px,92vw)] flex-col items-center gap-3 text-center">
        <div class="flex flex-col items-center gap-0">
          <div class="leading-[0] -mb-2 sm:-mb-3">
            <img
              src={publicAsset('/logos/resoria-transparent.png')}
              alt="Resoria"
              width="400"
              height="140"
              loading="lazy"
              decoding="async"
              class="mx-auto block h-20 w-auto opacity-90 sm:h-24 md:h-28"
            />
          </div>
          <p class="mt-1 text-sm text-resoria-muted">{content.footer.tagline}</p>
        </div>
        <nav aria-label={content.lang === 'es' ? 'Enlaces del pie de página' : 'Footer links'}>
          <ul class="flex flex-wrap items-center justify-center gap-6">
            <li>
              <a href={legalPaths.privacy} class="text-sm text-resoria-muted transition-colors hover:text-resoria-blue">
                {content.footer.privacy}
              </a>
            </li>
            <li>
              <a href={legalPaths.terms} class="text-sm text-resoria-muted transition-colors hover:text-resoria-blue">
                {content.footer.terms}
              </a>
            </li>
            <li>
              <a
                href={whatsappLink}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={whatsappAriaLabel}
                class="inline-flex items-center gap-2 text-sm text-resoria-muted transition-colors hover:text-[#25D366]"
              >
                <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                </svg>
                <span>{whatsappNumber}</span>
              </a>
            </li>
          </ul>
        </nav>
        <p class="text-xs text-resoria-dim">
          &copy; {new Date().getFullYear()} Resoria. {content.footer.rights}
        </p>
      </div>
    </footer>
    <script>
      import '../scripts/scroll-reveal.ts';
    </script>
  </body>
</html>
